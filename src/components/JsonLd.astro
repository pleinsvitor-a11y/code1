---
import { SITE } from '@/config/site';
const origin = SITE.domain.replace(/\/+$/, '');
const org = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#org`,
      name: 'VOLGUS',
      url: origin,
      logo: `${origin}/brand/icon-512.png`,
      email: SITE.email,
      founder: { '@type': 'Person', name: SITE.founder, sameAs: [SITE.instagramPessoal] },
      sameAs: [SITE.instagramMarca, SITE.instagramPessoal],
      address: { '@type': 'PostalAddress', addressLocality: 'Maringá', addressRegion: 'PR', addressCountry: 'BR' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${origin}/#service`,
      name: 'VOLGUS — Estruturação e gestão comercial',
      description: SITE.description,
      url: origin,
      image: `${origin}/og/volgus.png`,
      telephone: `+${SITE.whatsapp}`,
      email: SITE.email,
      founder: { '@type': 'Person', name: SITE.founder },
      parentOrganization: { '@id': `${origin}/#org` },
      areaServed: { '@type': 'Country', name: 'Brasil' },
      address: { '@type': 'PostalAddress', addressLocality: 'Maringá', addressRegion: 'PR', addressCountry: 'BR' },
      serviceType: 'Consultoria de estruturação e gestão comercial para PMEs',
    },
  ],
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(org)} />
