---
import Pattern from '@/components/ui/Pattern.astro';
const etapas = [
  { l: 'M', n: '01', nome: 'Mapear', t: 'Entender onde a empresa está. Diagnóstico 360º do pré ao pós-venda, análise de canais, funis, comportamento e rotina. Leitura real dos gargalos, não achismo.' },
  { l: 'E', n: '02', nome: 'Estruturar', t: 'Criar a fundação do comercial que funciona e se mantém. Plano de ação por canal, metas e indicadores, revisão de CRM, criação de scripts, funis e régua de abordagem.' },
  { l: 'T', n: '03', nome: 'Treinar', t: 'O time precisa saber o que fazer e como. Treinamento ao vivo, abordagem, objeções, técnica e pitch, integrados à rotina comercial.' },
  { l: 'A', n: '04', nome: 'Acompanhar', t: 'A diferença entre ter um plano e ter resultado. Reuniões 1:1, suporte ativo, relatórios de progresso e revisão contínua dos indicadores.' },
];
---
<section id="metodo" data-surface="claro" class="secao metodo" aria-labelledby="metodo-titulo" data-metodo>
  <span class="secao-label" aria-hidden="true">§ 04</span>
  <div class="container">
    <h2 id="metodo-titulo" class="t-display t-h1 metodo-titulo">Método tem nome.</h2>

    <div class="metodo-trilha" aria-hidden="true">
      <Pattern kind="dots" opacity={0.1} />
      <span class="metodo-regua"><span class="metodo-regua-fill" data-metodo-fill></span></span>
      <ol class="metodo-marcas">
        {etapas.map((e, i) => <li class="metodo-marca t-display" data-metodo-marca={i}>{e.l}</li>)}
      </ol>
    </div>

    <ol class="metodo-etapas">
      {etapas.map((e, i) => (
        <li class="metodo-etapa" data-metodo-etapa={i}>
          <span class="metodo-letra t-display" aria-hidden="true">{e.l}</span>
          <h3 class="metodo-nome">
            <span class="metodo-num t-micro">{e.n}</span>
            <span class="t-display metodo-nome-txt">{e.nome}</span>
          </h3>
          <p class="metodo-txt">{e.t}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .metodo-titulo { margin-bottom: clamp(3rem, 6vw, 5rem); font-variation-settings: "opsz" 96, "wdth" 88; }

  .metodo-trilha { position: relative; display: none; height: 5.5rem; margin-bottom: 3rem; }
  .metodo-regua { position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: var(--linha); }
  .metodo-regua-fill { position: absolute; inset: 0; width: 100%; background: #baff00; transform-origin: left; }
  .metodo-marcas { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); height: 100%; }
  .metodo-marca {
    display: grid; place-items: center; width: 3.25rem; height: 3.25rem; margin-top: calc(2.75rem - 1.625rem);
    border-radius: 50%; background: var(--surface); box-shadow: inset 0 0 0 1px var(--ink);
    font-size: 1.375rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em;
  }

  .metodo-etapas { display: grid; gap: clamp(2.5rem, 6vw, 4rem); counter-reset: etapa; }
  .metodo-etapa { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 1.25rem; row-gap: 0.75rem; align-items: start; border-top: 1px solid var(--linha); padding-top: 1.5rem; }
  .metodo-letra {
    grid-row: 1 / 3; display: grid; place-items: center;
    width: 3.5rem; height: 3.5rem; border-radius: 50%;
    background: #000000; color: #baff00;
    font-size: 1.5rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em;
  }
  .metodo-etapa:nth-child(2) .metodo-letra { background: #baff00; color: #000000; }
  .metodo-etapa:nth-child(3) .metodo-letra { background: #ffffff; color: #000000; box-shadow: inset 0 0 0 1px #000; }
  .metodo-nome { display: flex; flex-direction: column; gap: 0.25rem; }
  .metodo-num { color: var(--ink-2); }
  .metodo-nome-txt { font-size: var(--text-h3); font-weight: 700; letter-spacing: -0.02em; text-transform: uppercase; font-variation-settings: "opsz" 40, "wdth" 85; line-height: 1; }
  .metodo-txt { grid-column: 2; color: var(--ink-2); max-width: 40ch; }

  @media (min-width: 1024px) {
    .metodo-trilha { display: block; }
    .metodo-etapas { grid-template-columns: repeat(4, 1fr); gap: clamp(1.5rem, 2.5vw, 2.5rem); }
    .metodo-etapa { grid-template-columns: 1fr; grid-template-rows: auto auto 1fr; row-gap: 1rem; border-top: 0; padding-top: 0; }
    .metodo-letra {
      grid-row: auto; width: auto; height: auto; border-radius: 0; background: none !important; color: var(--ink) !important; box-shadow: none !important;
      place-items: start; font-size: clamp(6rem, 9vw, 9rem); line-height: 0.85; letter-spacing: -0.05em; margin-left: -0.05em;
      font-variation-settings: "opsz" 96, "wdth" 75;
    }
    .metodo-txt { grid-column: 1; font-size: 1rem; }
  }
</style>
