---
import Pattern from '@/components/ui/Pattern.astro';
const passos = ['ICP', 'Funil', 'Scripts', 'CRM'];
---
<section id="ordem" data-surface="branco" class="secao ordem" aria-labelledby="ordem-titulo">
  <span class="secao-label" aria-hidden="true">§ 05</span>
  <div class="container">
    <h2 id="ordem-titulo" class="t-display t-h2 ordem-titulo">A maioria compra a ferramenta primeiro. Por isso a ferramenta não funciona.</h2>

    <ol class="ordem-fluxo" aria-label="A ordem certa">
      {passos.map((p, i) => (
        <li class="ordem-item">
          <span class={`ordem-caixa t-display ${i === passos.length - 1 ? 'ordem-caixa-crm' : ''}`}>
            <Pattern kind="lines-v" opacity={0.12} />
            <span class="ordem-caixa-txt">{p}</span>
          </span>
          {i < passos.length - 1 && (
            <span class="ordem-seta" aria-hidden="true">
              <svg viewBox="0 0 48 16" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1"><path d="M0 8h46" vector-effect="non-scaling-stroke"/></svg>
              <svg class="ordem-seta-ponta" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="1"><path d="M1 1l5 5-5 5"/></svg>
            </span>
          )}
        </li>
      ))}
    </ol>

    <p class="ordem-fecho">A VOLGUS nunca vende CRM. Instala o processo que torna o CRM útil.</p>
  </div>
</section>

<style>
  .ordem-titulo { max-width: 26ch; margin-bottom: clamp(3rem, 6vw, 5rem); font-variation-settings: "opsz" 96, "wdth" 88; }
  .ordem-fluxo { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
  .ordem-item { display: flex; flex-direction: column; align-items: flex-start; }
  .ordem-caixa {
    position: relative; display: grid; place-items: center; overflow: hidden;
    min-width: 9rem; padding: 1.25rem 1.75rem; box-shadow: inset 0 0 0 1px var(--ink);
    font-size: var(--text-h3); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1;
    font-variation-settings: "opsz" 40, "wdth" 100;
  }
  .ordem-caixa-txt { position: relative; }
  .ordem-caixa-crm { box-shadow: none; outline: 1px dashed var(--ink); outline-offset: -1px; }
  .ordem-caixa-crm :global(.pattern) { display: none; }
  .ordem-seta { display: flex; align-items: center; color: var(--ink); opacity: 0.6; }
  /* vertical connector on small screens */
  .ordem-seta { flex-direction: column; height: 2.5rem; margin-left: 4.5rem; }
  .ordem-seta svg:first-child { width: 1px; height: 100%; transform: rotate(0); display: none; }
  .ordem-seta::before { content: ""; width: 1px; flex: 1; background: currentColor; }
  .ordem-seta-ponta { width: 8px; height: 12px; transform: rotate(90deg); }
  .ordem-fecho {
    margin-top: clamp(3rem, 6vw, 5rem); max-width: 30ch;
    font-family: var(--font-display); font-weight: 500; font-size: var(--text-h3); line-height: 1.3; letter-spacing: -0.015em; font-variation-settings: "opsz" 40, "wdth" 100;
  }
  @media (min-width: 900px) {
    .ordem-fluxo { flex-direction: row; align-items: center; flex-wrap: wrap; row-gap: 1.5rem; }
    .ordem-item { flex-direction: row; align-items: center; }
    .ordem-seta { flex-direction: row; height: auto; width: clamp(3rem, 6vw, 6rem); margin: 0; }
    .ordem-seta::before { height: 1px; width: auto; }
    .ordem-seta-ponta { transform: none; }
  }
</style>
