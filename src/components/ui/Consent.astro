---
/** Minimal cookie notice. Rendered only when a tracking ID is configured. */
import { SITE } from '@/config/site';
const enabled = Boolean(SITE.metaPixelId || SITE.ga4Id);
---
{enabled && (
  <div class="consent" data-consent hidden role="region" aria-label="Aviso de cookies">
    <p>Este site usa ferramentas de medição de audiência. Elas só ligam se você aceitar. <a href="/privacidade">Saiba mais</a>.</p>
    <div class="consent-acoes">
      <button type="button" class="consent-btn consent-sim" data-consent-yes>Aceitar</button>
      <button type="button" class="consent-btn" data-consent-no>Recusar</button>
    </div>
  </div>
)}

<style>
  .consent {
    position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 60;
    display: grid; gap: 1rem; max-width: 34rem; margin-inline: auto;
    padding: 1.25rem 1.5rem; background: #000000; color: #ffffff; border: 1px solid rgb(255 255 255 / 0.16); border-radius: 0.5rem;
    font-size: 0.9375rem;
  }
  .consent a { text-decoration: underline; text-underline-offset: 3px; }
  .consent-acoes { display: flex; gap: 0.75rem; }
  .consent-btn { min-height: 2.75rem; padding-inline: 1.25rem; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3); font-weight: 600; }
  .consent-sim { background: #baff00; color: #000000; box-shadow: none; }
</style>

<script>
  import { getConsent, loadTracking, setConsent } from '@/lib/analytics';
  const box = document.querySelector<HTMLElement>('[data-consent]');
  if (box) {
    const c = getConsent();
    if (c === 'granted') loadTracking();
    else if (c === null) box.hidden = false;
    box.querySelector('[data-consent-yes]')?.addEventListener('click', () => { setConsent('granted'); box.hidden = true; });
    box.querySelector('[data-consent-no]')?.addEventListener('click', () => { setConsent('denied'); box.hidden = true; });
  }
</script>
