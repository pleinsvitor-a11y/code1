---
/**
 * One of the four MIV patterns rendered as an SVG <pattern>.
 * Paints with currentColor; opacity stays between 6% and 12%.
 */
interface Props {
  [key: string]: unknown;
  kind: 'grid' | 'dots' | 'lines-v' | 'lines-h';
  opacity?: number;
  class?: string;
}
const { kind, opacity = 0.08, class: className = '', ...rest } = Astro.props;
const id = `pat-${kind}-${Math.random().toString(36).slice(2, 8)}`;
const size = kind === 'grid' ? 32 : kind === 'dots' ? 16 : 8;
---
<svg class={`pattern ${className}`} {...rest} aria-hidden="true" focusable="false" style={`opacity:${opacity}`}>
  <defs>
    <pattern id={id} width={size} height={size} patternUnits="userSpaceOnUse">
      {kind === 'grid' && <path d="M0 .5H32M.5 0V32" fill="none" stroke="currentColor" stroke-width="1" />}
      {kind === 'dots' && <circle cx="8" cy="8" r="1" fill="currentColor" />}
      {kind === 'lines-v' && <path d="M.5 0V8" fill="none" stroke="currentColor" stroke-width="1" />}
      {kind === 'lines-h' && <path d="M0 .5H8" fill="none" stroke="currentColor" stroke-width="1" />}
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
