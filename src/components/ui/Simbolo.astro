---
/** The calligraphic V. Draws from the page sprite so the path exists once. */
interface Props { [key: string]: unknown; class?: string; title?: string }
import { SIMBOLO_VIEWBOX } from '@/lib/brand-paths';
const { class: className = '', title, ...rest } = Astro.props;
---
<svg class={className} viewBox={SIMBOLO_VIEWBOX} xmlns="http://www.w3.org/2000/svg" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} focusable="false" {...rest}>
  {title && <title>{title}</title>}
  <use href="#volgus-simbolo" />
</svg>
