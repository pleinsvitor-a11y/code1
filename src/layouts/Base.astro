---
import '@/styles/global.css';
import { SITE } from '@/config/site';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Cursor from '@/components/ui/Cursor.astro';
import Consent from '@/components/ui/Consent.astro';
import JsonLd from '@/components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide nav + footer (used by /diagnostico). */
  bare?: boolean;
  /** Minimal nav: logo only. */
  minimalNav?: boolean;
  noindex?: boolean;
  ogImage?: string;
  /** Skip Lenis/GSAP (the diagnostic is an app screen, not a scroll page). */
  motion?: boolean;
}
const {
  title = SITE.title,
  description = SITE.description,
  bare = false,
  minimalNav = false,
  noindex = false,
  ogImage = '/og/volgus.png',
  motion = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.domain).toString();
const ogUrl = new URL(ogImage, SITE.domain).toString();
---
<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/work-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <JsonLd />
    <slot name="head" />
  </head>
  <body data-mode="preto" data-motion={motion ? 'on' : 'off'}>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    {!bare && <Nav minimal={minimalNav} />}
    <div class="page">
      <div class="regua" aria-hidden="true"></div>
      <main id="conteudo" tabindex="-1">
        <slot />
      </main>
    </div>
    {!bare && <Footer />}
    {!bare && <Cursor />}
    <Consent />
    <script>
      import { captureUtm } from '@/lib/utm';
      import { initSurfaceObserver } from '@/lib/surface';
      captureUtm();
      // Motion (GSAP + Lenis) is a separate chunk, loaded only on scroll pages.
      if (document.body.dataset.motion !== 'off') {
        initSurfaceObserver();
        import('@/lib/motion').then((m) => m.initMotion());
      }
    </script>
  </body>
</html>

<style>
  .page { position: relative; }
  main:focus { outline: none; }
</style>
